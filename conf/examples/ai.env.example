# In conf/ai.env & /etc/hexapod-ai/ai.env
DEVICE_ID="hexapod-s3-01"
LLM_ENABLED=1

LLM_BASE_URL="http://127.0.0.1:20128/v1"
LLM_API_KEY="spiderbot"

# Use the multimodal model for everything
LLM_MODEL="hexapod-vision"
LLM_VISION_MODEL="hexapod-vision"
SNAPSHOT_URL="http://127.0.0.1:8088/snapshot"

# TTS Configuration ("local" = 100% offline Piper, "hexapod-voice" = OmniRoute Cloud)
TTS_MODEL="local"
TTS_VOICE="alloy"
TTS_TIMEOUT_S=3.0